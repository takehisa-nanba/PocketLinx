{
  "version": 2,
  "os": "linux",
  "arch": "amd64",
  "command": ["/bin/sh", "/workspace/hello.sh"],
  "workdir": "/workspace",
  "uid": 1000,
  "gid": 1001,
  "env": {"GREETING": "hello", "DATA_FILE": "/data/message.txt"},
  "source": {"target": "/workspace"},
  "volumes": [{"name": "data", "target": "/data"}]
}
